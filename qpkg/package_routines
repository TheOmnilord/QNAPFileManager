# QDK package routines for QNAPFileManager.
# Variables such as SYS_QPKG_DIR are provided by the QDK install framework.

pkg_post_install(){
    mkdir -p "$SYS_QPKG_DIR/config" "$SYS_QPKG_DIR/logs"
    # Deliberately no seeded config: the daemon starts on its defaults —
    # read-only, loopback only — and the break-glass listener binds NOTHING
    # until an operator runs, as root on the NAS shell:
    #
    #   qnapfilemanager break-glass set-password
    #
    # There is no HTTP route that sets the password and no unauthenticated
    # bootstrap window of any kind (M4 contract §2.5, §4.1). Seeding a config
    # here would have to invent a credential.
    #
    # The config holds the break-glass password hash and the self-signed
    # certificate's private key; the audit log holds every path this app has
    # touched. Admin-only, all of them.
    chmod 700 "$SYS_QPKG_DIR/config" "$SYS_QPKG_DIR/logs"
    [ -f "$SYS_QPKG_DIR/config/config.json" ] && chmod 600 "$SYS_QPKG_DIR/config/config.json"
    [ -f "$SYS_QPKG_DIR/config/breakglass-key.pem" ] && chmod 600 "$SYS_QPKG_DIR/config/breakglass-key.pem"
    [ -f "$SYS_QPKG_DIR/config/breakglass-cert.pem" ] && chmod 600 "$SYS_QPKG_DIR/config/breakglass-cert.pem"
    :
}

pkg_post_remove(){
    # The per-volume .@qfm_trash directories are deliberately left in place:
    # they hold files a user deleted and may still want back, and removing an
    # app is not a decision to destroy them.
    :
}
